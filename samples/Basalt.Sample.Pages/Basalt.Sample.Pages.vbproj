<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Basalt.Sample.Pages</RootNamespace>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <BasaltProjectDir>$(MSBuildProjectDirectory)</BasaltProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="BasaltProjectDir" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Pages\**\*.vbpage" />

    <!--
      The package's own .props compute this from %(Identity); the sample
      declares its own AdditionalFiles instead of importing that .props, so
      it is repeated here. Without it the IDE, which builds through a
      symlinked checkout, resolves a template's AdditionalFiles path through
      the physical filesystem while BasaltProjectDir keeps the symlinked path
      as given: the two never match, and every page falls back to its bare
      file name for both its route and its namespace.
    -->
    <AdditionalFiles Update="Pages\**\*.vbpage">
      <BasaltRelativePath Condition="'%(BasaltRelativePath)' == '' and !$([System.IO.Path]::IsPathRooted('%(Identity)'))">%(Identity)</BasaltRelativePath>
      <BasaltRelativePath Condition="'%(BasaltRelativePath)' == '' and $([System.IO.Path]::IsPathRooted('%(Identity)'))">$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), %(FullPath)))</BasaltRelativePath>
    </AdditionalFiles>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="BasaltRelativePath" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Basalt.Razor.Vb.AspNetCore\Basalt.Razor.Vb.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Basalt.Razor.Vb.Hosting\Basalt.Razor.Vb.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Basalt.Razor.Vb.Generator\Basalt.Razor.Vb.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
