<%@ Import System.Linq %>
<!DOCTYPE html>
<html>
<head><title>Basalt Pages</title></head>
<body>
    <h1>Hello from a .vbp page</h1>

    <% Dim names = {"Ada", "Grace", "Margaret"} %>

    <ul>
    <% For Each name In names %>
        <li><%= name %></li>
    <% Next %>
    </ul>

    <p>Total: <%= names.Count() %></p>
</body>
</html>
