<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Basalt.Sample.Mvc</RootNamespace>
    <!-- The sample is built and exercised by the tests, never shipped. -->
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Serves _framework/blazor.web.js for the interactive component: the
         SDK turns it on by itself only for projects with .razor files. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Basalt.Razor.Vb.AspNetCore\Basalt.Razor.Vb.AspNetCore.csproj" />
    <!-- The generator compiles the .vbhtml views into ordinary classes. -->
    <ProjectReference Include="..\..\src\Basalt.Razor.Vb.Generator\Basalt.Razor.Vb.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      The package's own .props supply this; the sample uses a ProjectReference
      instead, so it declares it here. Without it a Razor Page is registered
      under /Hello.cshtml rather than /Pages/Hello.cshtml and never routes.
    -->
    <BasaltProjectDir>$(MSBuildProjectDirectory)</BasaltProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="BasaltProjectDir" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Views\**\*.vbhtml" />
    <AdditionalFiles Include="Pages\**\*.vbhtml" />
    <AdditionalFiles Include="Areas\**\*.vbhtml" />
    <AdditionalFiles Include="Components\**\*.vbrazor" />

    <!--
      The package's own .props compute this from %(Identity); the sample
      declares its own AdditionalFiles instead of importing that .props (its
      globs are narrower than the package's **/*), so it is repeated here.
      Without it the IDE, which builds through a symlinked checkout, resolves
      a template's AdditionalFiles path through the physical filesystem while
      BasaltProjectDir keeps the symlinked path as given: the two never
      match, every view is reported outside the project (VBH103), and every
      component gets the wrong namespace.
    -->
    <AdditionalFiles Update="Views\**\*.vbhtml;Pages\**\*.vbhtml;Areas\**\*.vbhtml;Components\**\*.vbrazor">
      <BasaltRelativePath Condition="'%(BasaltRelativePath)' == '' and !$([System.IO.Path]::IsPathRooted('%(Identity)'))">%(Identity)</BasaltRelativePath>
      <BasaltRelativePath Condition="'%(BasaltRelativePath)' == '' and $([System.IO.Path]::IsPathRooted('%(Identity)'))">$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), %(FullPath)))</BasaltRelativePath>
    </AdditionalFiles>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="BasaltRelativePath" />
  </ItemGroup>

  <!--
    The package targets, as a project using the package gets them: CSS
    isolation for .vbrazor.css among them.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../../src/Basalt.Razor.Vb.Generator/build/Basalt.Razor.Vb.targets" />

</Project>
