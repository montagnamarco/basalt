@* The root a Blazor Web App renders: the page shell, the router, the script. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <!-- The components' scoped styles, bundled by the build (CSS isolation). -->
    <link rel="stylesheet" href="Basalt.Sample.Mvc.styles.css" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
