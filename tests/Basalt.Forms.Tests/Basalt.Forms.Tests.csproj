<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Basalt.Forms\Basalt.Forms.csproj" />
    <ProjectReference Include="..\..\src\Basalt.Forms.VisualBasic\Basalt.Forms.VisualBasic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same formatter that wrote Microsoft's reference lists, shared with Basalt.Drawing's gate. -->
    <Compile Include="..\Basalt.Drawing.Tests\Api\ApiSurface.cs" Link="Api\ApiSurface.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same scenarios the Windows generator runs, run here with Basalt.Forms. -->
    <Compile Include="..\Basalt.Forms.Goldens\Scenarios.cs" Link="Goldens\Scenarios.cs" />
    <None Include="Goldens\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
