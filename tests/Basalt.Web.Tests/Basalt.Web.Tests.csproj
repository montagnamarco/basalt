<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      A web SDK project, and separate from Basalt.Tests: exercising the views
      means starting a real ASP.NET Core host, and the IDE's test project has
      no business carrying a web framework to do it.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Basalt.Web.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- As in Basalt.Tests: the web SDK does not bring these in on its own. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Basalt.Sample.Mvc\Basalt.Sample.Mvc.vbproj" />
  </ItemGroup>

</Project>
