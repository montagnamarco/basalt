<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Basalt.Drawing\Basalt.Drawing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What SkiaVersionTests compares: the versions this build was given and where NuGet keeps packages. -->
    <AssemblyMetadata Include="AvaloniaVersion" Value="$(AvaloniaVersion)" />
    <AssemblyMetadata Include="SkiaSharpVersion" Value="$(SkiaSharpVersion)" />
    <AssemblyMetadata Include="NuGetPackageRoot" Value="$(NuGetPackageRoot)" />
  </ItemGroup>

</Project>
