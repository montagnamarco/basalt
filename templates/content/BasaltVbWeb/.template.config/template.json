{
  "$schema": "http://json.schemastore.org/template",
  "author": "Basalt",
  "classifications": [
    "Web",
    "Empty",
    "Visual Basic"
  ],
  "identity": "Basalt.VisualBasic.Web",
  "name": "ASP.NET Core Empty",
  "shortName": "web",
  "tags": {
    "language": "VB",
    "type": "project"
  },
  "sourceName": "BasaltVbWeb",
  "preferNameDirectory": true,
  "groupIdentity": "Microsoft.Web.Empty",
  "precedence": "10000",
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target net10.0"
        },
        {
          "choice": "net9.0",
          "description": "Target net9.0"
        }
      ],
      "replaces": "net10.0",
      "defaultValue": "net10.0"
    }
  },
  "primaryOutputs": [
    {
      "path": "BasaltVbWeb.vbproj"
    },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "Program.vb"
    }
  ],
  "defaultName": "VbWeb"
}
