@* The router: every component with an @Page directive in this assembly. *@

@*#if (UseWebAssembly)
<Router AppAssembly="@GetType(Routes).Assembly" AdditionalAssemblies="@ClientAssemblies">
#else
<Router AppAssembly="@GetType(Routes).Assembly">
#endif*@
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@GetType(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
