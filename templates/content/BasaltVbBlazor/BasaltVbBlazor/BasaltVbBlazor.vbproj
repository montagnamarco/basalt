<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BasaltVbBlazor</RootNamespace>
    <Nullable>enable</Nullable>
    <!--
      Serves _framework/blazor.web.js. The SDK turns this on by itself only
      for a project with .razor files; without it the script is a 404 and no
      component is ever interactive.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Basalt.Razor.Vb" Version="1.0.0" />
<!--#if (UseWebAssembly) -->
<!--#if (Framework == "net9.0") -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.0" />
<!--#else -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.0" />
<!--#endif -->
    <ProjectReference Include="..\BasaltVbBlazor.Client\BasaltVbBlazor.Client.vbproj" />
<!--#endif -->
  </ItemGroup>

</Project>
