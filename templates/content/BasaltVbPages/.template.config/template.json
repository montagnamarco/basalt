{
  "$schema": "http://json.schemastore.org/template",
  "author": "Basalt",
  "classifications": [
    "Web",
    "Pages",
    "Visual Basic"
  ],
  "identity": "Basalt.VisualBasic.Pages",
  "name": "Web site of .vbpage pages, Visual Basic",
  "description": "A site where a file is a page, in the shape of Classic ASP and PHP: no controllers, no models, and the file's own path is its URL.",
  "shortName": "vbpages",
  "tags": {
    "language": "VB",
    "type": "project"
  },
  "sourceName": "BasaltVbPages",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target net10.0"
        },
        {
          "choice": "net9.0",
          "description": "Target net9.0"
        }
      ],
      "replaces": "net10.0",
      "defaultValue": "net10.0"
    }
  },
  "primaryOutputs": [
    {
      "path": "BasaltVbPages.vbproj"
    },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "Pages/Index.vbpage"
    }
  ],
  "defaultName": "VbPages"
}
