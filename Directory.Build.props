<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <RoslynVersion>5.9.0</RoslynVersion>
  </PropertyGroup>

  <!--
    Package metadata, in one place so the three published packages cannot drift
    apart. Version is here for the same reason: they are released together and
    a project that mixes versions of them gets a generator and a runtime that
    disagree about the shape of a generated view.
  -->
  <PropertyGroup>
    <!--
      Nothing is published unless it says so. The default is true, which would
      have put the IDE, the workspace layer and the language server on
      nuget.org the first time anyone ran dotnet pack on the solution.
    -->
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>

    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Marco Montagna</Authors>
    <Company>Marco Montagna</Company>
    <Copyright>Copyright (c) 2026 Marco Montagna</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/montagnamarco/basalt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/montagnamarco/basalt.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!--
      A symbol package and a source link, so a debugger can step from a
      consuming project into this code rather than stopping at a stack frame
      with no source behind it.

      Defaulted rather than forced: a package with no build output has nothing
      for a .snupkg to carry, and pack fails outright with NU5017 rather than
      producing an empty one. Those projects set IncludeSymbols false
      themselves — this file is imported before them, so a condition here on
      IncludeBuildOutput would read it before it has been set.
    -->
    <IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- A restore against a feed missing a package should fail, not warn. -->
    <TreatWarningsAsErrors Condition="'$(IsPackable)' == 'true'">false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
