{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Basalt Pages (Visual Basic)",
  "scopeName": "text.html.vbpage",
  "patterns": [
    { "include": "#directive" },
    { "include": "#members" },
    { "include": "#raw-expression" },
    { "include": "#expression" },
    { "include": "#code" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "directive": {
      "name": "meta.directive.vbpage",
      "begin": "<%@",
      "end": "%>",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vbpage" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.vbpage" } },
      "patterns": [
        {
          "match": "\\b(Import|Namespace)\\b",
          "name": "keyword.control.directive.vbpage"
        },
        { "include": "source.asp.vb.net" }
      ]
    },

    "members": {
      "name": "meta.embedded.block.vbpage",
      "begin": "<%!",
      "end": "%>",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vbpage" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.vbpage" } },
      "patterns": [{ "include": "source.asp.vb.net" }]
    },

    "raw-expression": {
      "name": "meta.embedded.expression.raw.vbpage",
      "begin": "<%==",
      "end": "%>",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vbpage" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.vbpage" } },
      "patterns": [{ "include": "source.asp.vb.net" }]
    },

    "expression": {
      "name": "meta.embedded.expression.vbpage",
      "begin": "<%=",
      "end": "%>",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vbpage" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.vbpage" } },
      "patterns": [{ "include": "source.asp.vb.net" }]
    },

    "code": {
      "name": "meta.embedded.block.vbpage",
      "begin": "<%",
      "end": "%>",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.vbpage" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.vbpage" } },
      "patterns": [{ "include": "source.asp.vb.net" }]
    }
  }
}
