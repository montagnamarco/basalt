{
  "comments": {
    "blockComment": ["@*", "*@"]
  },
  "brackets": [
    ["<", ">"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "<", "close": ">" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "@*", "close": " *@" }
  ],
  "surroundingPairs": [
    ["<", ">"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(?i)^\\s*@?(If .*Then|For |For Each |While |Do |Select Case |Code)\\s*$|<(?!area|base|br|col|hr|img|input|link|meta|param)([a-zA-Z][^>]*[^/])?>\\s*$",
    "decreaseIndentPattern": "(?i)^\\s*@?(End If|End While|End Code|End Select|Next|Loop|Else|ElseIf)|^\\s*</"
  }
}
