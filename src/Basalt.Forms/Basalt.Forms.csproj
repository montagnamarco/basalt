<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Packed inside Basalt.WinForms (src/Basalt.WinForms), with the other four assemblies it needs. -->
    <IsPackable>false</IsPackable>

    <!--
      Microsoft's name, for the reason Basalt.Drawing carries
      System.Drawing.Common's: a compiled WinForms library or application binds
      by simple name and ignores the public key. A net10.0 binary asks for
      10.0.0.0 and the runtime refuses a lower version.
    -->
    <AssemblyName>System.Windows.Forms</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Basalt.Accessibility\Basalt.Accessibility.vbproj" />
    <ProjectReference Include="..\Basalt.Drawing\Basalt.Drawing.csproj" />
    <ProjectReference Include="..\Basalt.Forms.Primitives\Basalt.Forms.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The platform layer only: windows, input, clipboard, screens. Every control is drawn by us. -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaWebViewVersion)" />
    <!-- Generated applications need this reader for typed .resx values. -->
    <PackageReference Include="System.Resources.Extensions" Version="$(SystemResourcesExtensionsVersion)" />
    <PackageReference Include="System.IO.Ports" Version="$(SystemIoPortsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Basalt.Forms.Tests" />
    <!--
      The IDE's design surface hosts the internal FormsCanvas Avalonia control
      (Internal/Hosting) to paint the form being designed, and there is no
      public equivalent: exposing one would add API Microsoft's assembly does
      not have, which ApiSurfaceTests forbids. Harmless in the Basalt.WinForms
      package: it grants nothing at run time, only to an assembly that is
      itself named Basalt.Shell, and no consumer has one.
    -->
    <InternalsVisibleTo Include="Basalt.Shell" />
  </ItemGroup>

</Project>
