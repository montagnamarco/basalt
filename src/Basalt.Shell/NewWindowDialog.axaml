<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Basalt.Shell"
        x:Class="Basalt.Shell.NewWindowDialog"
        Title="{l:LocalizedString NewWindow_Title}"
        Width="460" Height="280"
        MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Margin="20" Spacing="10">

    <TextBlock Text="{l:LocalizedString NewWindow_Heading}" FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="LanguageLabel" Opacity="0.7" FontSize="12" />

    <StackPanel Spacing="3">
      <TextBlock Text="{l:LocalizedString NewWindow_ClassName}" FontSize="12" />
      <TextBox x:Name="NameBox" PlaceholderText="{l:LocalizedString NewWindow_ClassNamePlaceholder}" />
    </StackPanel>

    <StackPanel Spacing="3">
      <TextBlock Text="{l:LocalizedString NewWindow_Namespace}" FontSize="12" />
      <TextBox x:Name="NamespaceBox" PlaceholderText="{l:LocalizedString NewWindow_NamespacePlaceholder}" />
    </StackPanel>

    <StackPanel Spacing="3">
      <TextBlock Text="{l:LocalizedString NewWindow_WindowTitle}" FontSize="12" />
      <TextBox x:Name="TitleBox" PlaceholderText="{l:LocalizedString NewWindow_WindowTitlePlaceholder}" />
    </StackPanel>

    <TextBlock x:Name="ErrorLabel" Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12" />

    <!-- Windows/Visual Studio button order: the primary action leads, Cancel
         follows it, the pair right-aligned. Enter triggers Create (IsDefault),
         Esc triggers Cancel (IsCancel). -->
    <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CreateButton" Content="{l:LocalizedString Button_Create}" Click="OnCreate" Classes="primary" IsDefault="True" />
      <Button x:Name="CancelButton" Content="{l:LocalizedString Button_Cancel}" Click="OnCancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
