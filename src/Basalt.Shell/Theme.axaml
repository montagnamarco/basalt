<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Basalt.Shell">

  <!--
    The themes' palettes. Every theme defines the same keys; the custom
    themes are variants declared in IdeThemes, because a variant that is not
    built in cannot be written as a plain key in XAML and needs `x:Static`.

    A key a theme does not define falls back to the base variant, so a
    palette only needs to say where it differs. Here, though, all of them
    say everything, so each theme reads whole in one place.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
    <Color x:Key="EditorBackground">#FFFFFF</Color>
    <Color x:Key="EditorForeground">#1F1F1F</Color>
    <Color x:Key="SideBarBackground">#F8F8F8</Color>
    <Color x:Key="SideBarBorder">#D0D0D0</Color>
    <Color x:Key="ActivityBarBackground">#F8F8F8</Color>
    <Color x:Key="TabActiveBackground">#FFFFFF</Color>
    <Color x:Key="TabInactiveBackground">#F8F8F8</Color>
    <Color x:Key="TabBorder">#D0D0D0</Color>
    <Color x:Key="TabActiveBorderTop">#005FB8</Color>
    <Color x:Key="StatusBarBackground">#005FB8</Color>
    <Color x:Key="StatusBarForeground">#FFFFFF</Color>
    <Color x:Key="DebugBannerBackground">#FFF4E5</Color>
    <Color x:Key="DebugBannerForeground">#7A4B00</Color>
    <Color x:Key="DebugBannerBorder">#E8C99B</Color>
    <Color x:Key="DesignerOutside">#E4E6EA</Color>
    <Color x:Key="DesignerForm">#FFFFFF</Color>
    <Color x:Key="TitleBarBackground">#F8F8F8</Color>
    <Color x:Key="PanelBorder">#D0D0D0</Color>
    <Color x:Key="ListHoverBackground">#E8E8E8</Color>
    <Color x:Key="ListActiveSelectionBackground">#0060C0</Color>
    <Color x:Key="ListActiveSelectionForeground">#FFFFFF</Color>
    <Color x:Key="ListInactiveSelectionBackground">#E4E6F1</Color>
    <Color x:Key="FocusBorder">#005FB8</Color>
    <Color x:Key="InputBackground">#FFFFFF</Color>
    <Color x:Key="InputBorder">#B0B0B0</Color>
    <Color x:Key="ButtonBackground">#005FB8</Color>
    <Color x:Key="ButtonForeground">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryBackground">#DDDDDD</Color>
    <Color x:Key="ButtonSecondaryForeground">#1F1F1F</Color>
    <Color x:Key="ErrorForeground">#C42B1C</Color>
    <Color x:Key="WarningForeground">#9A6700</Color>
    <Color x:Key="DescriptionForeground">#5A5A5A</Color>
    <Color x:Key="SuccessForeground">#1A7F37</Color>
    <Color x:Key="ChromeForeground">#1F1F1F</Color>
    <Color x:Key="ChromeSecondaryForeground">#5A5A5A</Color>
    <Color x:Key="ScrollbarSlider">#A6A6A6</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
    <!--
      The VS Code Dark palette ("Dark+"), the mirror of the light one: the
      same names with the dark theme's values, so every brush below holds
      for both.
    -->
    <Color x:Key="EditorBackground">#1F1F1F</Color>
    <Color x:Key="EditorForeground">#D4D4D4</Color>
    <Color x:Key="SideBarBackground">#181818</Color>
    <Color x:Key="SideBarBorder">#3C3C3C</Color>
    <Color x:Key="ActivityBarBackground">#181818</Color>
    <Color x:Key="TabActiveBackground">#1F1F1F</Color>
    <Color x:Key="TabInactiveBackground">#181818</Color>
    <Color x:Key="TabBorder">#3C3C3C</Color>
    <Color x:Key="TabActiveBorderTop">#0078D4</Color>
    <Color x:Key="StatusBarBackground">#0078D4</Color>
    <Color x:Key="StatusBarForeground">#FFFFFF</Color>
    <Color x:Key="DebugBannerBackground">#3A2E1A</Color>
    <Color x:Key="DebugBannerForeground">#F0C070</Color>
    <Color x:Key="DebugBannerBorder">#5A472A</Color>
    <Color x:Key="DesignerOutside">#1A1A1A</Color>
    <Color x:Key="DesignerForm">#2B2B2B</Color>
    <Color x:Key="TitleBarBackground">#181818</Color>
    <Color x:Key="PanelBorder">#3C3C3C</Color>
    <Color x:Key="ListHoverBackground">#2A2D2E</Color>
    <Color x:Key="ListActiveSelectionBackground">#04395E</Color>
    <Color x:Key="ListActiveSelectionForeground">#FFFFFF</Color>
    <Color x:Key="ListInactiveSelectionBackground">#37373D</Color>
    <Color x:Key="FocusBorder">#0078D4</Color>
    <Color x:Key="InputBackground">#313131</Color>
    <Color x:Key="InputBorder">#3C3C3C</Color>
    <Color x:Key="ButtonBackground">#0078D4</Color>
    <Color x:Key="ButtonForeground">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryBackground">#313131</Color>
    <Color x:Key="ButtonSecondaryForeground">#CCCCCC</Color>
    <Color x:Key="ErrorForeground">#F85149</Color>
    <Color x:Key="WarningForeground">#D29922</Color>
    <Color x:Key="DescriptionForeground">#A6A6A6</Color>
    <Color x:Key="SuccessForeground">#3FB950</Color>
    <Color x:Key="ChromeForeground">#D4D4D4</Color>
    <Color x:Key="ChromeSecondaryForeground">#A6A6A6</Color>
    <Color x:Key="ScrollbarSlider">#4F4F4F</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static shell:IdeThemes.VisualStudioBlue}">
    <Color x:Key="EditorBackground">#FFFFFF</Color>
    <Color x:Key="EditorForeground">#000000</Color>
    <Color x:Key="SideBarBackground">#EEEEF2</Color>
    <Color x:Key="SideBarBorder">#CCCEDB</Color>
    <Color x:Key="ActivityBarBackground">#EEEEF2</Color>
    <Color x:Key="TabActiveBackground">#FFFFFF</Color>
    <Color x:Key="TabInactiveBackground">#CCCEDB</Color>
    <Color x:Key="TabBorder">#CCCEDB</Color>
    <Color x:Key="TabActiveBorderTop">#007ACC</Color>
    <Color x:Key="StatusBarBackground">#007ACC</Color>
    <Color x:Key="StatusBarForeground">#FFFFFF</Color>
    <Color x:Key="DebugBannerBackground">#FFF4E5</Color>
    <Color x:Key="DebugBannerForeground">#7A4B00</Color>
    <Color x:Key="DebugBannerBorder">#E8C99B</Color>
    <Color x:Key="DesignerOutside">#E4E6EA</Color>
    <Color x:Key="DesignerForm">#FFFFFF</Color>
    <Color x:Key="TitleBarBackground">#EEEEF2</Color>
    <Color x:Key="PanelBorder">#CCCEDB</Color>
    <Color x:Key="ListHoverBackground">#C9DEF5</Color>
    <Color x:Key="ListActiveSelectionBackground">#3399FF</Color>
    <Color x:Key="ListActiveSelectionForeground">#FFFFFF</Color>
    <Color x:Key="ListInactiveSelectionBackground">#DDDDDD</Color>
    <Color x:Key="FocusBorder">#007ACC</Color>
    <Color x:Key="InputBackground">#FFFFFF</Color>
    <Color x:Key="InputBorder">#CCCEDB</Color>
    <Color x:Key="ButtonBackground">#007ACC</Color>
    <Color x:Key="ButtonForeground">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryBackground">#DDDDDD</Color>
    <Color x:Key="ButtonSecondaryForeground">#000000</Color>
    <Color x:Key="ErrorForeground">#A31515</Color>
    <Color x:Key="WarningForeground">#8A6D00</Color>
    <Color x:Key="DescriptionForeground">#555555</Color>
    <Color x:Key="SuccessForeground">#1A7F37</Color>
    <Color x:Key="ChromeForeground">#000000</Color>
    <Color x:Key="ChromeSecondaryForeground">#555555</Color>
    <Color x:Key="ScrollbarSlider">#C2C3C9</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static shell:IdeThemes.HighContrastLight}">
    <Color x:Key="EditorBackground">#FFFFFF</Color>
    <Color x:Key="EditorForeground">#000000</Color>
    <Color x:Key="SideBarBackground">#FFFFFF</Color>
    <Color x:Key="SideBarBorder">#000000</Color>
    <Color x:Key="ActivityBarBackground">#FFFFFF</Color>
    <Color x:Key="TabActiveBackground">#FFFFFF</Color>
    <Color x:Key="TabInactiveBackground">#FFFFFF</Color>
    <Color x:Key="TabBorder">#000000</Color>
    <Color x:Key="TabActiveBorderTop">#0000FF</Color>
    <Color x:Key="StatusBarBackground">#000000</Color>
    <Color x:Key="StatusBarForeground">#FFFFFF</Color>
    <Color x:Key="DebugBannerBackground">#FFFFFF</Color>
    <Color x:Key="DebugBannerForeground">#000000</Color>
    <Color x:Key="DebugBannerBorder">#000000</Color>
    <Color x:Key="DesignerOutside">#C0C0C0</Color>
    <Color x:Key="DesignerForm">#FFFFFF</Color>
    <Color x:Key="TitleBarBackground">#FFFFFF</Color>
    <Color x:Key="PanelBorder">#000000</Color>
    <Color x:Key="ListHoverBackground">#000000</Color>
    <Color x:Key="ListActiveSelectionBackground">#0000FF</Color>
    <Color x:Key="ListActiveSelectionForeground">#FFFFFF</Color>
    <Color x:Key="ListInactiveSelectionBackground">#C0C0C0</Color>
    <Color x:Key="FocusBorder">#0000FF</Color>
    <Color x:Key="InputBackground">#FFFFFF</Color>
    <Color x:Key="InputBorder">#000000</Color>
    <Color x:Key="ButtonBackground">#000000</Color>
    <Color x:Key="ButtonForeground">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryBackground">#FFFFFF</Color>
    <Color x:Key="ButtonSecondaryForeground">#000000</Color>
    <Color x:Key="ErrorForeground">#B50000</Color>
    <Color x:Key="WarningForeground">#6B4E00</Color>
    <Color x:Key="DescriptionForeground">#000000</Color>
    <Color x:Key="SuccessForeground">#006400</Color>
    <Color x:Key="ChromeForeground">#000000</Color>
    <Color x:Key="ChromeSecondaryForeground">#000000</Color>
    <Color x:Key="ScrollbarSlider">#000000</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static shell:IdeThemes.HighContrastDark}">
    <Color x:Key="EditorBackground">#000000</Color>
    <Color x:Key="EditorForeground">#FFFFFF</Color>
    <Color x:Key="SideBarBackground">#000000</Color>
    <Color x:Key="SideBarBorder">#FFFFFF</Color>
    <Color x:Key="ActivityBarBackground">#000000</Color>
    <Color x:Key="TabActiveBackground">#000000</Color>
    <Color x:Key="TabInactiveBackground">#000000</Color>
    <Color x:Key="TabBorder">#FFFFFF</Color>
    <Color x:Key="TabActiveBorderTop">#1AEBFF</Color>
    <Color x:Key="StatusBarBackground">#000000</Color>
    <Color x:Key="StatusBarForeground">#FFFFFF</Color>
    <Color x:Key="DebugBannerBackground">#000000</Color>
    <Color x:Key="DebugBannerForeground">#FFD700</Color>
    <Color x:Key="DebugBannerBorder">#FFD700</Color>
    <Color x:Key="DesignerOutside">#000000</Color>
    <Color x:Key="DesignerForm">#1A1A1A</Color>
    <Color x:Key="TitleBarBackground">#000000</Color>
    <Color x:Key="PanelBorder">#FFFFFF</Color>
    <Color x:Key="ListHoverBackground">#FFFFFF</Color>
    <Color x:Key="ListActiveSelectionBackground">#1AEBFF</Color>
    <Color x:Key="ListActiveSelectionForeground">#000000</Color>
    <Color x:Key="ListInactiveSelectionBackground">#3F3F3F</Color>
    <Color x:Key="FocusBorder">#1AEBFF</Color>
    <Color x:Key="InputBackground">#000000</Color>
    <Color x:Key="InputBorder">#FFFFFF</Color>
    <Color x:Key="ButtonBackground">#1AEBFF</Color>
    <Color x:Key="ButtonForeground">#000000</Color>
    <Color x:Key="ButtonSecondaryBackground">#000000</Color>
    <Color x:Key="ButtonSecondaryForeground">#FFFFFF</Color>
    <Color x:Key="ErrorForeground">#FF6B6B</Color>
    <Color x:Key="WarningForeground">#FFD700</Color>
    <Color x:Key="DescriptionForeground">#FFFFFF</Color>
    <Color x:Key="SuccessForeground">#3FF23F</Color>
    <Color x:Key="ChromeForeground">#FFFFFF</Color>
    <Color x:Key="ChromeSecondaryForeground">#FFFFFF</Color>
    <Color x:Key="ScrollbarSlider">#FFFFFF</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static shell:IdeThemes.SolarizedLight}">
    <Color x:Key="EditorBackground">#FDF6E3</Color>
    <Color x:Key="EditorForeground">#586E75</Color>
    <Color x:Key="SideBarBackground">#EEE8D5</Color>
    <Color x:Key="SideBarBorder">#D9D2C0</Color>
    <Color x:Key="ActivityBarBackground">#EEE8D5</Color>
    <Color x:Key="TabActiveBackground">#FDF6E3</Color>
    <Color x:Key="TabInactiveBackground">#EEE8D5</Color>
    <Color x:Key="TabBorder">#D9D2C0</Color>
    <Color x:Key="TabActiveBorderTop">#268BD2</Color>
    <Color x:Key="StatusBarBackground">#1F6FA8</Color>
    <Color x:Key="StatusBarForeground">#FDF6E3</Color>
    <Color x:Key="DebugBannerBackground">#EEE8D5</Color>
    <Color x:Key="DebugBannerForeground">#A5760B</Color>
    <Color x:Key="DebugBannerBorder">#D6CCB0</Color>
    <Color x:Key="DesignerOutside">#DDD6C1</Color>
    <Color x:Key="DesignerForm">#FDF6E3</Color>
    <Color x:Key="TitleBarBackground">#EEE8D5</Color>
    <Color x:Key="PanelBorder">#D9D2C0</Color>
    <Color x:Key="ListHoverBackground">#E4DCC7</Color>
    <Color x:Key="ListActiveSelectionBackground">#1F6FA8</Color>
    <Color x:Key="ListActiveSelectionForeground">#FDF6E3</Color>
    <Color x:Key="ListInactiveSelectionBackground">#E4DCC7</Color>
    <Color x:Key="FocusBorder">#268BD2</Color>
    <Color x:Key="InputBackground">#FDF6E3</Color>
    <Color x:Key="InputBorder">#93A1A1</Color>
    <Color x:Key="ButtonBackground">#1F6FA8</Color>
    <Color x:Key="ButtonForeground">#FDF6E3</Color>
    <Color x:Key="ButtonSecondaryBackground">#EEE8D5</Color>
    <Color x:Key="ButtonSecondaryForeground">#586E75</Color>
    <Color x:Key="ErrorForeground">#DC322F</Color>
    <Color x:Key="WarningForeground">#B58900</Color>
    <Color x:Key="DescriptionForeground">#657B83</Color>
    <Color x:Key="SuccessForeground">#6B7A00</Color>
    <Color x:Key="ChromeForeground">#073642</Color>
    <Color x:Key="ChromeSecondaryForeground">#50656B</Color>
    <Color x:Key="ScrollbarSlider">#93A1A1</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static shell:IdeThemes.SolarizedDark}">
    <Color x:Key="EditorBackground">#002B36</Color>
    <Color x:Key="EditorForeground">#93A1A1</Color>
    <Color x:Key="SideBarBackground">#073642</Color>
    <Color x:Key="SideBarBorder">#0E4453</Color>
    <Color x:Key="ActivityBarBackground">#073642</Color>
    <Color x:Key="TabActiveBackground">#002B36</Color>
    <Color x:Key="TabInactiveBackground">#073642</Color>
    <Color x:Key="TabBorder">#0E4453</Color>
    <Color x:Key="TabActiveBorderTop">#268BD2</Color>
    <Color x:Key="StatusBarBackground">#1F6FA8</Color>
    <Color x:Key="StatusBarForeground">#FDF6E3</Color>
    <Color x:Key="DebugBannerBackground">#0B3A45</Color>
    <Color x:Key="DebugBannerForeground">#B58900</Color>
    <Color x:Key="DebugBannerBorder">#12525F</Color>
    <Color x:Key="DesignerOutside">#00212B</Color>
    <Color x:Key="DesignerForm">#073642</Color>
    <Color x:Key="TitleBarBackground">#073642</Color>
    <Color x:Key="PanelBorder">#0E4453</Color>
    <Color x:Key="ListHoverBackground">#0E4453</Color>
    <Color x:Key="ListActiveSelectionBackground">#1F6FA8</Color>
    <Color x:Key="ListActiveSelectionForeground">#FDF6E3</Color>
    <Color x:Key="ListInactiveSelectionBackground">#0E4453</Color>
    <Color x:Key="FocusBorder">#268BD2</Color>
    <Color x:Key="InputBackground">#073642</Color>
    <Color x:Key="InputBorder">#586E75</Color>
    <Color x:Key="ButtonBackground">#1F6FA8</Color>
    <Color x:Key="ButtonForeground">#FDF6E3</Color>
    <Color x:Key="ButtonSecondaryBackground">#073642</Color>
    <Color x:Key="ButtonSecondaryForeground">#93A1A1</Color>
    <Color x:Key="ErrorForeground">#DC322F</Color>
    <Color x:Key="WarningForeground">#B58900</Color>
    <Color x:Key="DescriptionForeground">#839496</Color>
    <Color x:Key="SuccessForeground">#859900</Color>
    <Color x:Key="ChromeForeground">#EEE8D5</Color>
    <Color x:Key="ChromeSecondaryForeground">#9FB0B0</Color>
    <Color x:Key="ScrollbarSlider">#586E75</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{DynamicResource EditorBackground}" />
  <SolidColorBrush x:Key="EditorForegroundBrush" Color="{DynamicResource EditorForeground}" />
  <SolidColorBrush x:Key="SideBarBackgroundBrush" Color="{DynamicResource SideBarBackground}" />
  <SolidColorBrush x:Key="SideBarBorderBrush" Color="{DynamicResource SideBarBorder}" />
  <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="{DynamicResource TabActiveBackground}" />
  <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="{DynamicResource TabInactiveBackground}" />
  <SolidColorBrush x:Key="TabBorderBrush" Color="{DynamicResource TabBorder}" />
  <SolidColorBrush x:Key="TabActiveBorderTopBrush" Color="{DynamicResource TabActiveBorderTop}" />
  <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{DynamicResource StatusBarBackground}" />
  <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="{DynamicResource StatusBarForeground}" />
  <SolidColorBrush x:Key="DebugBannerBackgroundBrush" Color="{DynamicResource DebugBannerBackground}" />
  <SolidColorBrush x:Key="DebugBannerForegroundBrush" Color="{DynamicResource DebugBannerForeground}" />
  <SolidColorBrush x:Key="DebugBannerBorderBrush" Color="{DynamicResource DebugBannerBorder}" />
  <SolidColorBrush x:Key="DesignerOutsideBrush" Color="{DynamicResource DesignerOutside}" />
  <SolidColorBrush x:Key="DesignerFormBrush" Color="{DynamicResource DesignerForm}" />
  <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{DynamicResource TitleBarBackground}" />
  <SolidColorBrush x:Key="PanelBorderBrush" Color="{DynamicResource PanelBorder}" />
  <SolidColorBrush x:Key="ListHoverBackgroundBrush" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource InputBackground}" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource InputBorder}" />
  <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{DynamicResource ButtonBackground}" />
  <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{DynamicResource ButtonForeground}" />
  <SolidColorBrush x:Key="ButtonSecondaryBackgroundBrush" Color="{DynamicResource ButtonSecondaryBackground}" />
  <SolidColorBrush x:Key="ButtonSecondaryForegroundBrush" Color="{DynamicResource ButtonSecondaryForeground}" />
  <SolidColorBrush x:Key="ErrorForegroundBrush" Color="{DynamicResource ErrorForeground}" />
  <SolidColorBrush x:Key="WarningForegroundBrush" Color="{DynamicResource WarningForeground}" />
  <SolidColorBrush x:Key="SuccessForegroundBrush" Color="{DynamicResource SuccessForeground}" />
  <SolidColorBrush x:Key="DescriptionForegroundBrush" Color="{DynamicResource DescriptionForeground}" />
  <!--
    The text of the chrome (title bars, tabs). Separate from the editor's and
    the description's because those are chosen against the editor's surface:
    Solarized Light's reads 4.4:1 on its side bar, under what text needs.
  -->
  <SolidColorBrush x:Key="ChromeForegroundBrush" Color="{DynamicResource ChromeForeground}" />
  <SolidColorBrush x:Key="ChromeSecondaryForegroundBrush" Color="{DynamicResource ChromeSecondaryForeground}" />


  <!--
    Typography and sizes shared by the panels. Code-built panels read the same
    numbers from Controls/PanelMetrics.cs; a test keeps the two in step.
  -->
  <x:Double x:Key="PanelFontSize">12</x:Double>
  <x:Double x:Key="PanelSecondaryFontSize">11</x:Double>
  <x:Double x:Key="PanelRowHeight">22</x:Double>


  <!--
    Fluent's list and tree rows read their hover and selection colours from
    these keys. Pointing them at the IDE's tokens gives every list and tree the
    theme's own hover and selection without restyling a template: before, a
    row was Fluent's accent-tinted grey whatever the theme, and ListHover and
    ListActiveSelection were read by almost nothing.
  -->
  <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="{DynamicResource ListInactiveSelectionBackground}" />
  <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="{DynamicResource ListInactiveSelectionBackground}" />
  <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="{DynamicResource ListInactiveSelectionBackground}" />
  <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="{DynamicResource EditorForeground}" />
  <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver" Color="{DynamicResource EditorForeground}" />
  <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPressed" Color="{DynamicResource EditorForeground}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{DynamicResource ListInactiveSelectionBackground}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{DynamicResource ListInactiveSelectionBackground}" />
  <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="{DynamicResource ListInactiveSelectionBackground}" />
  <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="{DynamicResource EditorForeground}" />
  <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="{DynamicResource EditorForeground}" />
  <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="{DynamicResource EditorForeground}" />

  <!-- Brushes for tokens that were colours only. -->
  <SolidColorBrush x:Key="ActivityBarBackgroundBrush" Color="{DynamicResource ActivityBarBackground}" />
  <SolidColorBrush x:Key="ListActiveSelectionBackgroundBrush" Color="{DynamicResource ListActiveSelectionBackground}" />
  <SolidColorBrush x:Key="ListActiveSelectionForegroundBrush" Color="{DynamicResource ListActiveSelectionForeground}" />
  <SolidColorBrush x:Key="ListInactiveSelectionBackgroundBrush" Color="{DynamicResource ListInactiveSelectionBackground}" />
  <SolidColorBrush x:Key="FocusBorderBrush" Color="{DynamicResource FocusBorder}" />
  <SolidColorBrush x:Key="ScrollbarSliderBrush" Color="{DynamicResource ScrollbarSlider}" />

  <!--
    Dock's chrome, taken from the IDE's own tokens.

    The Dock theme package ships presets (VsCodeLight, VsCodeDark) that are
    plain brushes with fixed colours; including one left every tool panel
    pale in the dark themes. These are the same keys the package reads, but
    each is a brush over an IDE colour, so the chrome follows the theme the
    moment the variant changes. A test checks that every key the presets
    define is defined here.
  -->
  <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="{DynamicResource SideBarBackground}" />
  <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="{DynamicResource SideBarBackground}" />
  <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="{DynamicResource EditorBackground}" />
  <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="{DynamicResource SideBarBackground}" />
  <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="{DynamicResource TitleBarBackground}" />
  <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="{DynamicResource TitleBarBackground}" />
  <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="{DynamicResource PanelBorder}" />
  <SolidColorBrush x:Key="DockBorderStrongBrush" Color="{DynamicResource SideBarBorder}" />
  <SolidColorBrush x:Key="DockSeparatorBrush" Color="{DynamicResource PanelBorder}" />
  <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="{DynamicResource PanelBorder}" />
  <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="{DynamicResource FocusBorder}" />
  <SolidColorBrush x:Key="DockSplitterDragBrush" Color="{DynamicResource FocusBorder}" />
  <SolidColorBrush x:Key="DockTabBackgroundBrush" Color="Transparent" />
  <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="{DynamicResource TabActiveBackground}" />
  <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="{DynamicResource TabActiveBorderTop}" />
  <SolidColorBrush x:Key="DockTabForegroundBrush" Color="{DynamicResource ChromeSecondaryForeground}" />
  <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="{DynamicResource ChromeForeground}" />
  <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="{DynamicResource ChromeForeground}" />
  <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="{DynamicResource FocusBorder}" Opacity="0.4" />
  <SolidColorBrush x:Key="DockChromeButtonForegroundBrush" Color="{DynamicResource ChromeSecondaryForeground}" />
  <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="{DynamicResource ListInactiveSelectionBackground}" />
  <SolidColorBrush x:Key="DockChromeButtonDangerHoverBrush" Color="{DynamicResource ListHoverBackground}" />
  <SolidColorBrush x:Key="DockChromeGripBrush" Color="Transparent" />
  <CornerRadius x:Key="DockCornerRadiusSmall">0</CornerRadius>

</ResourceDictionary>
