<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Basalt.Shell.Controls"
        xmlns:dock="using:Dock.Avalonia.Controls">

  <!--
    Stili che avvicinano i controlli Fluent all'aspetto di VS Code: angoli vivi,
    spaziature ridotte e testo più piccolo del predefinito Fluent.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource EditorForegroundBrush}" />
  </Style>

  <!-- Barra dei menu in-finestra (Windows e Linux) -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource TitleBarBackgroundBrush}" />
    <Setter Property="Padding" Value="4,2" />
  </Style>

  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Campi di testo -->
  <!--
    Every input a notch smaller than Fluent's default. Fluent sizes for a
    finger on a tablet; an IDE is used with a pointer, and a form of
    touch-sized fields wastes the space the work needs.
  -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Pulsante primario, come quello blu di VS Code -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0258A8" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
  </Style>

  <!-- Elenchi e alberi: righe compatte, selezione piena come VS Code -->
  <Style Selector="TreeView, ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="{DynamicResource PanelRowHeight}" />
    <Setter Property="Padding" Value="2,0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource PanelRowHeight}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
  </Style>

  <!-- Intestazioni dei pannelli laterali: maiuscoletto, come VS Code -->
  <Style Selector="TextBlock.panelHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource DescriptionForegroundBrush}" />
    <Setter Property="Margin" Value="12,8,8,6" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <!--
    Fluent gives a check box a minimum height of 32 for a control about 20
    high, so a column of switches reads as a list of unrelated things however
    small the gap between them is made.
  -->
  <!--
    Height 20, not less: the box inside measures 20 whatever it is scaled to,
    and a shorter control cuts its bottom edge off — the ticked ones came out
    with the blue clipped. The scale is what makes it read small; this only
    has to leave room for what is being scaled.
  -->
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="RadioButton">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!--
    The boxes themselves, which Fluent draws at 20 for a 32-high control.
    Fourteen here: in the property grid a tick is one row of forty, and at
    fifteen it still stood taller than the combo beside it.
  -->
  <!--
    The box itself.

    Fluent writes Width="20" into the template, and a value set on the element
    beats any style: setting 15, then 14, then 13 here changed nothing, and
    measuring showed the element still reporting 20. It is scaled down instead
    — a transform is applied after layout, so nothing the template says can
    override it.

    Scaled about its own middle, so it shrinks in place rather than drifting
    towards one corner of the row.
  -->
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="RenderTransform">
      <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
    </Setter>
  </Style>

  <!--
    The cell the box sits in, which Fluent lays out at 20 by 32 whatever size
    the box itself is given. Sizing only the Border left it centred in a cell
    half again as tall as the row, so the box looked large and its neighbours
    looked misaligned — the measurement said 20 every time.
  -->
  <!--
    The cell the box sits in.

    Left at the box's own 20 rather than squeezed: the box still *measures*
    20 whatever it is scaled to, so a narrower cell clips it — the ticked one
    came out with its bottom edge cut off. The scale is what makes it look
    smaller; the cell only has to not cut it.

    The other half is where the cell sits within the row, and that is a
    second local value: the template writes VerticalAlignment="Top" directly
    onto this Grid, and — exactly like the Width above — a value set on the
    element beats a Style's Setter for the same property, so a
    VerticalAlignment Setter here is silently ignored (measured: the control
    still reports Top). With the control squeezed to the CheckBox style's
    Height of 20, the cell keeps measuring its template height of 32 and,
    top-aligned, overflows downward from the shared top edge, and the
    Viewbox's own scale (set above on the Border) shifts the measured
    position further still. Measured against a label at this FontSize (every
    box in the app shares it, from the Style below), the box's centre lands
    nine pixels below the row's, which reads as the box sitting below its
    label. RenderTransform is not fought over by the template, so a
    TranslateTransform can do here what the Setter could not: move the cell
    up by that same nine pixels, putting its centre back on the row's.
  -->
  <Style Selector="CheckBox /template/ Grid#RootGrid > Grid">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="RenderTransform">
      <TranslateTransform Y="-9" />
    </Setter>
  </Style>

  <!--
    The tick, scaled with the box so the two keep their proportions.
  -->
  <Style Selector="CheckBox /template/ Viewbox">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <Style Selector="RadioButton /template/ Ellipse#OuterEllipse">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <Style Selector="RadioButton /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!--
    VerticalContentAlignment set here, on the control itself, and not on the
    inner PART_TextBox below: Fluent's own NumericUpDown template binds
    PART_TextBox's VerticalContentAlignment with a TemplateBinding back to
    this same property on the NumericUpDown, and a TemplateBinding outranks
    a Style setter aimed at the same property on that same element — a
    setter placed directly on "/template/ TextBox#PART_TextBox" below is
    silently overridden back to the template's own default (Stretch), which
    left the digits sitting at the top of the box instead of centred like
    every TextBox in the app. Setting it here, where nothing competes for
    the property, is what the TemplateBinding actually picks up.
  -->
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="NumericUpDown /template/ RepeatButton">
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    The glyphs on a panel's title bar.

    Dock's own are font outlines: the pin's geometry measures 1571 by 2464
    units. Squeezed into a 12 by 12 box they come out as an unreadable smudge
    against the button's grey background — which is what "the icons are
    missing" means. They were drawn all along, just illegibly.

    Replaced with the IDE's own, drawn on a 16 by 16 grid and readable at the
    size a title bar allows. Seen by rendering a window with a solution open:
    with none, no panel exists and there is nothing to look at, which is how
    this got past a test that only ever built the welcome screen.
  -->
  <Style Selector="Button#PART_PinButton, Button#PART_MenuButton,
                   Button#PART_CloseButton, Button#PART_MaximizeRestoreButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <!--
    The glyph itself: Dock's are font outlines, and the pin's geometry
    measures 1571 by 2464 units. Stretched uniformly into a 12 by 12 box they
    are readable; left alone they fill the button as a solid smudge, which is
    what "the icons are missing" looked like.

    Set on the Path rather than replacing the button's Content: Dock assigns
    the Content locally, and a local value beats a style — the icons never
    arrived, while the test that measured them went on passing.
  -->
  <Style Selector="Button#PART_PinButton Path,
                   Button#PART_MenuButton Path,
                   Button#PART_CloseButton Path,
                   Button#PART_MaximizeRestoreButton Path">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
  </Style>

  <!--
    The Designer / XAML switch.

    Radio buttons for the behaviour, drawn as flat tabs: the native bullet
    beside an icon and a word reads as a form to fill in, when what it does is
    swap one view for another.
  -->
  <!--
    Height explicitly, and larger than the general RadioButton rule: that one
    caps every radio at 18 to keep forms compact, and a tab carrying an icon
    and a word needs more than that. Without it the label was clipped along
    its top edge, which read as the designer being broken.
  -->
  <Style Selector="RadioButton.viewSwitch">
    <Setter Property="Height" Value="26" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Body"
                Background="Transparent"
                BorderThickness="0,0,0,2"
                BorderBrush="Transparent"
                Padding="10,3">
          <ContentPresenter Content="{TemplateBinding Content}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="RadioButton.viewSwitch:pointerover /template/ Border#PART_Body">
    <Setter Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
  </Style>

  <Style Selector="RadioButton.viewSwitch:checked /template/ Border#PART_Body">
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBackgroundBrush}" />
  </Style>


  <!--
    Dock's chrome: the title bar of a tool panel, its tab strip and the
    splitters between panels.

    The colours come from the Dock* brushes in Theme.axaml, which are brushes
    over the IDE's tokens, so none of this is repeated per theme. What is set
    here is the shape: one compact height, a quiet title that turns to the
    foreground colour with an accent line under it when the panel has focus,
    and tabs that say which one is selected without a coloured fill, which
    in the dark themes was a light blue block with unreadable text.
  -->
  <Style Selector="dock|ToolChromeControl /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource DockSurfaceHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!--
    Dock paints the grip over the border with the panel surface, which hid the
    title bar brush: they only matched because the themes give both the same
    colour. Transparent lets the bar show the colour the theme names for it.
  -->
  <Style Selector="dock|ToolChromeControl /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="dock|ToolChromeControl:active /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource DockSurfaceHeaderActiveBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorderTopBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <Style Selector="dock|ToolChromeControl /template/ TextBlock#PART_Title">
    <Setter Property="FontSize" Value="{DynamicResource PanelFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeSecondaryForegroundBrush}" />
  </Style>

  <Style Selector="dock|ToolChromeControl:active /template/ TextBlock#PART_Title">
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    Tabs share the strip's width instead of being cut at its edge, and the
    scroll viewer stops measuring them at infinity so that sharing can happen.
  -->
  <Style Selector="dock|ToolTabStrip">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <controls:ShrinkingTabPanel />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="dock|ToolTabStrip /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="dock|ToolTabStripItem">
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="{DynamicResource PanelFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource DockTabForegroundBrush}" />
    <Setter Property="ToolTip.Tip" Value="{ReflectionBinding Title}" />
  </Style>

  <Style Selector="dock|ToolTabStripItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource DockTabHoverBackgroundBrush}" />
  </Style>

  <Style Selector="dock|ToolTabStripItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource DockTabSelectedForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource DockTabActiveBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockTabActiveIndicatorBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>

  <!-- A label too long for its share ends in an ellipsis; the tooltip has the whole of it. -->
  <Style Selector="dock|ToolTabStripItem /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>


  <!--
    Keyboard focus and selection on rows and toolbar buttons.

    The row that has focus gets the theme's focus colour as an outline drawn
    in the adorner layer, so it never moves the layout, and appears only for
    keyboard navigation. A selected row is filled with the active selection
    colour while its list has focus and with the quieter inactive one when it
    does not, so the user can see where the keyboard is.
  -->
  <Style Selector="Button, ToggleButton, ListBoxItem, TreeViewItem, CheckBox, RadioButton, ComboBox, TabItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="1"
                BorderBrush="{DynamicResource FocusBorderBrush}"
                IsHitTestVisible="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!--
    Hover, selection and focused selection, stated as styles as well as
    resources: Fluent's ListBoxItem reads its selected fill from a system
    accent brush rather than from the keys overridden in Theme.axaml, so the
    resources alone left every selected row Fluent's blue in every theme.
  -->
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ListInactiveSelectionBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorForegroundBrush}" />
  </Style>

  <Style Selector="ListBox:focus-within ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ListActiveSelectionBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ListActiveSelectionForegroundBrush}" />
  </Style>

  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
  </Style>

  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ListInactiveSelectionBackgroundBrush}" />
  </Style>

  <Style Selector="TreeView:focus-within TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ListActiveSelectionBackgroundBrush}" />
  </Style>

  <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource EditorForegroundBrush}" />
  </Style>

  <Style Selector="TreeView:focus-within TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource ListActiveSelectionForegroundBrush}" />
  </Style>

  <!--
    Panel toolbars (Problems, Output, Search): flat buttons that show a fill
    only under the pointer, and toggles that stay filled while pressed so a
    filter that is on reads differently from one that is off. Fluent's
    checked and hover fills are stated per state, hover chained after checked,
    because a plain hover rule would otherwise paint over a pressed toggle.
  -->
  <Style Selector="Button.panelTool, ToggleButton.panelTool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
  </Style>

  <Style Selector="Button.panelTool:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.panelTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ListHoverBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
  </Style>

  <Style Selector="ToggleButton.panelTool:checked /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.panelTool:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ListInactiveSelectionBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
  </Style>

  <!-- Rows of a data grid: the selection is visible whether or not the grid has the keyboard. -->
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ListHoverBackgroundBrush}" />
  </Style>

  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ListInactiveSelectionBackgroundBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="DataGridRow:selected DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource EditorForegroundBrush}" />
  </Style>

  <Style Selector="DataGrid:focus-within DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ListActiveSelectionBackgroundBrush}" />
  </Style>

  <Style Selector="DataGrid:focus-within DataGridRow:selected DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource ListActiveSelectionForegroundBrush}" />
  </Style>

  <!--
    Output lines: one style per severity instead of a theme subscription per
    line. The panel keeps up to five thousand lines; each used to carry its own.
  -->
  <Style Selector="SelectableTextBlock.outputLine">
    <Setter Property="FontSize" Value="{DynamicResource PanelFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorForegroundBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.outputLine.error">
    <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.outputLine.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.outputLine.success">
    <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
  </Style>

</Styles>
