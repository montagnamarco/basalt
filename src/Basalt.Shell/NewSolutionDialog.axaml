<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Basalt.Shell"
        x:Class="Basalt.Shell.NewSolutionDialog"
        Title="{l:LocalizedString NewSolution_Title}"
        Width="820" Height="560"
        MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource EditorBackgroundBrush}">

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="{DynamicResource SideBarBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
            Padding="20,16">
      <StackPanel Spacing="2">
        <TextBlock Text="{l:LocalizedString NewSolution_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{l:LocalizedString NewSolution_Subtitle}"
                   Foreground="{DynamicResource DescriptionForegroundBrush}" FontSize="12" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SideBarBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
            Padding="20,12">
      <!-- Windows/Visual Studio button order: the primary action leads, Cancel
           follows it, the pair right-aligned, as in the IDE's other dialogs
           (see NewWindowDialog). Enter triggers Create (IsDefault), Esc
           triggers Cancel (IsCancel). -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="ErrorLabel" Grid.Column="0"
                   Foreground="{DynamicResource ErrorForegroundBrush}"
                   TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
        <Button x:Name="CreateButton" Grid.Column="1" Content="{l:LocalizedString Button_Create}" Click="OnCreate" Margin="0,0,8,0"
                Classes="primary" IsDefault="True" />
        <Button x:Name="CancelButton" Grid.Column="2" Content="{l:LocalizedString Button_Cancel}" Click="OnCancel"
                IsCancel="True" />
      </Grid>
    </Border>

    <!--
      Right half: the tree of dialects, categories and leaves. Left half: the
      rest of the form. The user's own words for this window ("a treeview on
      the right with the dialects and project types, everything else on the
      left") are the layout, not a suggestion read into a different one.
    -->
    <Grid ColumnDefinitions="*,1,*">

      <ScrollViewer Grid.Column="0" x:Name="LeftPanel">
        <StackPanel Margin="20" Spacing="16">

          <StackPanel Spacing="4">
            <TextBlock x:Name="TemplateNameLabel" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
            <TextBlock x:Name="TemplateDescriptionLabel" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource DescriptionForegroundBrush}" />
            <TextBlock x:Name="TemplateTargetLabel" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource DescriptionForegroundBrush}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{l:LocalizedString NewSolution_Name}" FontWeight="SemiBold" FontSize="12" />
            <TextBox x:Name="NameBox" PlaceholderText="MyApplication" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{l:LocalizedString NewSolution_Location}" FontWeight="SemiBold" FontSize="12" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="PathBox" Grid.Column="0" />
              <Button Grid.Column="1" Content="{l:LocalizedString NewSolution_Browse}" Click="OnBrowse" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{l:LocalizedString NewSolution_SolutionName}" FontWeight="SemiBold" FontSize="12" />
            <TextBox x:Name="SolutionNameBox" />
          </StackPanel>

          <!--
            No local Height override needed: the app-wide CheckBox style
            (Styles.axaml) now corrects the box's vertical position itself
            with a RenderTransform, which the template does not fight over
            the way it does Height — so this box is centred on its label at
            the same compact Height="20" every other check box uses.
          -->
          <CheckBox x:Name="SameDirectoryCheck" Content="{l:LocalizedString NewSolution_PlaceInSameDirectory}" />

          <TextBlock x:Name="PreviewLabel" FontSize="11"
                     Foreground="{DynamicResource DescriptionForegroundBrush}" TextWrapping="Wrap" />

        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" />

      <StackPanel Grid.Column="2" Margin="16,20,20,20" Spacing="6">
        <TextBlock Text="{l:LocalizedString NewSolution_ProjectType}" FontWeight="SemiBold" FontSize="12" />
        <TreeView x:Name="TemplateTree" Background="{DynamicResource EditorBackgroundBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" />
      </StackPanel>

    </Grid>
  </DockPanel>
</Window>
