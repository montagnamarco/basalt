<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Basalt.Shell"
        x:Class="Basalt.Shell.NewSolutionDialog"
        Title="{l:LocalizedString NewSolution_Title}"
        Width="620" Height="500"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource EditorBackgroundBrush}">

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="{DynamicResource SideBarBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1"
            Padding="20,16">
      <StackPanel Spacing="2">
        <TextBlock Text="{l:LocalizedString NewSolution_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{l:LocalizedString NewSolution_Subtitle}"
                   Foreground="{DynamicResource DescriptionForegroundBrush}" FontSize="12" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SideBarBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="ErrorLabel" Grid.Column="0"
                   Foreground="{DynamicResource ErrorForegroundBrush}"
                   TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{l:LocalizedString Button_Cancel}" Click="OnCancel" Margin="0,0,8,0"
                IsCancel="True" />
        <Button Grid.Column="2" Content="{l:LocalizedString Button_Create}" Click="OnCreate" Classes="primary" IsDefault="True" />
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="20" Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="{l:LocalizedString NewSolution_ProjectType}" FontWeight="SemiBold" FontSize="12" />

          <ListBox x:Name="TemplateList" SelectedIndex="1" Height="300"
                   BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                   Background="{DynamicResource EditorBackgroundBrush}">
            <TextBlock Text="{l:LocalizedString NewSolution_VisualBasic}" FontWeight="Bold" FontSize="11" Margin="4,8,4,2"
                         Foreground="{DynamicResource DescriptionForegroundBrush}" />
            <ListBoxItem Tag="AvaloniaApp">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_AvaloniaApp}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_AvaloniaApp_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="ConsoleApp">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_ConsoleApp}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_ConsoleApp_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="ClassLibrary">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_ClassLibrary}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_ClassLibrary_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="TestProject">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_TestProject}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_TestProject_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <TextBlock Text="{l:LocalizedString NewSolution_Web}" FontWeight="Bold" FontSize="11" Margin="4,8,4,2"
                         Foreground="{DynamicResource DescriptionForegroundBrush}" />
            <ListBoxItem Tag="WebApi">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_WebApi}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_WebApi_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="WebApp">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_WebApp}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_WebApp_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="RazorPages">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_RazorPages}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_RazorPages_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Mvc">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_Mvc}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_Mvc_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Blazor">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_Blazor}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_Blazor_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <TextBlock Text="{l:LocalizedString NewSolution_OtherDialects}" FontWeight="Bold" FontSize="11" Margin="4,8,4,2"
                         Foreground="{DynamicResource DescriptionForegroundBrush}" />
            <ListBoxItem Tag="VisualBasic6">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_VisualBasic6}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_VisualBasic6_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="QuickBasic">
              <StackPanel Margin="4,6">
                <TextBlock Text="{l:LocalizedString Template_QuickBasic}" FontWeight="SemiBold" />
                <TextBlock Text="{l:LocalizedString Template_QuickBasic_Description}"
                           Foreground="{DynamicResource DescriptionForegroundBrush}"
                           FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </StackPanel>

        <StackPanel x:Name="GuiPanel" Spacing="6">
          <TextBlock Text="{l:LocalizedString NewSolution_Gui}" FontWeight="SemiBold" FontSize="12" />
          <ComboBox x:Name="GuiChoice" SelectedIndex="0" HorizontalAlignment="Stretch">
            <ComboBoxItem Tag="Avalonia" Content="Avalonia" />
            <ComboBoxItem Tag="WinForms" Content="{l:LocalizedString NewSolution_WinForms}" />
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="{l:LocalizedString NewSolution_Name}" FontWeight="SemiBold" FontSize="12" />
          <TextBox x:Name="NameBox" PlaceholderText="MyApplication" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="{l:LocalizedString NewSolution_Location}" FontWeight="SemiBold" FontSize="12" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="PathBox" Grid.Column="0" />
            <Button Grid.Column="1" Content="{l:LocalizedString NewSolution_Browse}" Click="OnBrowse" Margin="8,0,0,0" />
          </Grid>
          <TextBlock x:Name="PreviewLabel" FontSize="11"
                     Foreground="{DynamicResource DescriptionForegroundBrush}" TextWrapping="Wrap" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
