<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Basalt.Shell.ViewModels"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:l="clr-namespace:Basalt.Shell"
        xmlns:controls="using:Basalt.Shell.Controls"
        x:Class="Basalt.Shell.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Basalt"
        Icon="avares://Basalt.Shell/Assets/basalt.ico"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource EditorBackgroundBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding BuildCommand}" />
    <!-- F5 debugs and Ctrl+F5 runs without debugging, as in Visual Basic. -->
    <KeyBinding Gesture="Ctrl+F5" Command="{Binding RunCommand}" />
    <!-- View Code / View Designer, as in Visual Studio's own Forms designer. -->
    <KeyBinding Gesture="F7" Command="{Binding ViewCodeCommand}" />
    <KeyBinding Gesture="Shift+F7" Command="{Binding ViewDesignerCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <!--
      The menu bar: on macOS the menu is exported to the system menu bar at
      the top of the screen and this container stays hidden; on the other
      platforms it hosts the window's own menu. The entries are built in
      MainWindow.axaml.cs, once for both shapes.
    -->
    <Menu x:Name="WindowMenu" DockPanel.Dock="Top" />

    <!-- The actions reached most often, as icons: a toolbar exists to be used
         without reading, and the menus already spell the names out. -->
    <Border DockPanel.Dock="Top" x:Name="ToolbarHost"
            Background="{DynamicResource SideBarBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" />

    <!--
      The debug banner: while a session is running the window must say so
      without the user having to go looking for a panel. It sits under the
      toolbar, where Visual Studio shows its own yellow pause bar, and is
      hidden entirely when nothing is being debugged: a strip that is always
      there becomes invisible exactly when it matters.
    -->
    <Border DockPanel.Dock="Top" x:Name="DebugBanner"
            IsVisible="False" Padding="10,4,12,4"
            Background="{DynamicResource DebugBannerBackgroundBrush}"
            BorderBrush="{DynamicResource DebugBannerBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7"
                    VerticalAlignment="Center">
          <Ellipse x:Name="DebugBannerDot" Width="8" Height="8"
                   VerticalAlignment="Center"
                   Fill="{DynamicResource DebugBannerForegroundBrush}" />
          <TextBlock x:Name="DebugBannerText" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource DebugBannerForegroundBrush}" />
        </StackPanel>

        <TextBlock Grid.Column="1" x:Name="DebugBannerDetail" FontSize="12"
                   Margin="16,0,12,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource DebugBannerForegroundBrush}" />

        <Button Grid.Column="2" x:Name="DebugBannerStop" Click="OnDebugBannerStop"
                Padding="8,1" FontSize="12" Background="Transparent"
                BorderBrush="{DynamicResource DebugBannerForegroundBrush}"
                BorderThickness="1"
                Foreground="{DynamicResource DebugBannerForegroundBrush}"
                Content="{l:LocalizedString Debug_BannerStop}" />
      </Grid>
    </Border>

    <!-- The status bar, blue like VS Code's -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBarBackgroundBrush}" Padding="10,3">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <!-- The branch opens the branch list: seeing which branch you are on
             and wanting to change it are the same moment. -->
        <Button Grid.Column="0" x:Name="BranchButton" Click="OnStatusBranch"
                Padding="4,0" Background="Transparent" BorderThickness="0"
                IsVisible="{Binding CurrentBranch, Converter={x:Static ObjectConverters.IsNotNull}}"
                Margin="0,0,14,0">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="&#xE0A0;" Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentBranch}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{DynamicResource StatusBarForegroundBrush}"
                     FontSize="12" VerticalAlignment="Center" />

          <!-- Shown only while something long is running: a build that has
               gone wrong is one the user wants to end, not wait out. -->
          <Button x:Name="CancelOperationButton" Click="OnCancelOperation"
                  IsVisible="False" Padding="6,0" Background="Transparent"
                  BorderThickness="0" VerticalAlignment="Center">
            <TextBlock x:Name="CancelOperationLabel"
                       Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                    VerticalAlignment="Center" Margin="0,0,12,0">
          <!-- Where the caret is, and how the file is stored. Encoding and
               line ending matter more here than on one system: a file written
               on Windows and edited on macOS is the normal case. -->
          <!-- Each field is a button: clicking the position asks for a line,
               clicking the indentation changes it. A status bar that only
               reports is half a status bar. -->
          <Button x:Name="CaretPositionButton" Click="OnStatusGoToLine"
                  Classes="status" Padding="4,0" Background="Transparent"
                  BorderThickness="0" VerticalAlignment="Center">
            <TextBlock x:Name="CaretPositionLabel"
                       Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" />
          </Button>
          <Button x:Name="IndentationButton" Click="OnStatusIndentation"
                  Padding="4,0" Background="Transparent"
                  BorderThickness="0" VerticalAlignment="Center">
            <TextBlock x:Name="IndentationLabel"
                       Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" />
          </Button>
          <Button x:Name="LineEndingButton" Click="OnStatusLineEnding"
                  Padding="4,0" Background="Transparent"
                  BorderThickness="0" VerticalAlignment="Center">
            <TextBlock x:Name="LineEndingLabel"
                       Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" />
          </Button>
          <!-- Encoding and language read like the others and now act like
               them: a value shown but not changeable reads as a gap. -->
          <Button x:Name="EncodingButton" Click="OnStatusEncoding"
                  Padding="4,0" Background="Transparent"
                  BorderThickness="0" VerticalAlignment="Center">
            <TextBlock x:Name="EncodingLabel"
                       Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" />
          </Button>
          <Button x:Name="LanguageButton" Click="OnStatusLanguage"
                  Padding="4,0" Background="Transparent"
                  BorderThickness="0" VerticalAlignment="Center">
            <TextBlock x:Name="LanguageLabel"
                       Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" />
          </Button>
          <!-- How big the form being designed will really be, which the
               surface cannot show: it draws at whatever size the panel is. -->
          <TextBlock x:Name="DesignerSizeLabel"
                     Foreground="{DynamicResource StatusBarForegroundBrush}"
                     FontSize="12" VerticalAlignment="Center" />

          <TextBlock x:Name="DebugStateLabel"
                     Foreground="{DynamicResource StatusBarForegroundBrush}"
                     FontSize="12" VerticalAlignment="Center" />
          <!-- The error count opens the problems panel, which is what anyone
               reading a non-zero count wants next. -->
          <Button x:Name="ErrorSummaryButton" Click="OnStatusErrors"
                  Padding="4,0" Background="Transparent" BorderThickness="0"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ErrorSummary}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}"
                       FontSize="12" />
          </Button>
        </StackPanel>

        <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="90" Height="3"
                     IsVisible="{Binding IsBusy}" VerticalAlignment="Center"
                     Foreground="White" Background="#3D82C8" />
      </Grid>
    </Border>

    <!--
      The dockable area: every panel can be moved, docked side by side,
      floated into its own window or closed. The initial layout is built by
      FactoryIde.
    -->
    <Panel>
      <dock:DockControl x:Name="Docking" />

      <!--
        The welcome screen, visible as long as no documents are open: it
        makes the main actions reachable without going through the menu,
        which on macOS lives outside the window.
      -->
      <Border x:Name="WelcomePane"
              Background="{DynamicResource EditorBackgroundBrush}"
              IsHitTestVisible="{Binding IsWelcomeVisible}"
              IsVisible="{Binding IsWelcomeVisible}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="680" ColumnDefinitions="320,40,320">

          <!--
            Left: the solutions and files opened lately, as Visual Studio's
            own start page shows them. Filled in code because the list comes
            from the settings and changes while the IDE runs.
          -->
          <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock Text="{l:LocalizedString Welcome_Recent}"
                       FontSize="16" FontWeight="SemiBold" />
            <StackPanel x:Name="WelcomeRecent" Spacing="2" />
          </StackPanel>

          <!-- Right: the two ways to begin, with New Project first as the one most people want. -->
          <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Basalt" FontSize="30" FontWeight="Light" />
            <TextBlock Text="{l:LocalizedString Welcome_Subtitle}"
                       Foreground="{DynamicResource DescriptionForegroundBrush}"
                       Margin="0,0,0,14" />

            <TextBlock Text="{l:LocalizedString Welcome_GetStarted}"
                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2" />

            <!--
              A Grid, not a horizontal StackPanel, around the icon and text:
              a StackPanel measures each child with infinite available width,
              so the inner TextBlock's TextWrapping="Wrap" had no width to
              wrap within and the description's last words were clipped at
              the button's right edge instead ("…QuickBASIC p"). The Grid's
              "*" column gives the text an actual width to wrap inside, and
              the button grows taller to fit.
            -->
            <Button x:Name="WelcomeNewProjectButton" Classes="primary"
                    Click="OnNewSolutionClick" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Padding="10,8">
              <Grid ColumnDefinitions="Auto,10,*">
                <controls:IconView Grid.Column="0" Kind="New" IconSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Text="{l:LocalizedString Welcome_NewProject}" FontWeight="SemiBold" />
                  <TextBlock x:Name="WelcomeNewProjectDescription"
                             FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Button>

            <Button x:Name="WelcomeOpenProjectButton"
                    Click="OnOpenSolutionClick" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Padding="10,8">
              <Grid ColumnDefinitions="Auto,10,*">
                <controls:IconView Grid.Column="0" Kind="Open" IconSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Text="{l:LocalizedString Welcome_OpenProject}" FontWeight="SemiBold" />
                  <TextBlock x:Name="WelcomeOpenProjectDescription"
                             FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Panel>
  </DockPanel>
</Window>
