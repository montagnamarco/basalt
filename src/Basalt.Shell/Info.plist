<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    What macOS reads to name the application and to find its icon. Without
    this file a bundle carries neither: the menu bar shows the process name
    and the dock shows a blank sheet of paper.
  -->
  <key>CFBundleName</key>
  <string>Basalt</string>

  <key>CFBundleDisplayName</key>
  <string>Basalt</string>

  <key>CFBundleIdentifier</key>
  <string>it.montagnamarco.basalt</string>

  <key>CFBundleExecutable</key>
  <string>Basalt.Shell</string>

  <key>CFBundleIconFile</key>
  <string>basalt.icns</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleShortVersionString</key>
  <string>1.0</string>

  <key>CFBundleVersion</key>
  <string>1.0</string>

  <!-- Retina: without it the window is drawn at half resolution. -->
  <key>NSHighResolutionCapable</key>
  <true/>

  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>

  <!-- The files it knows how to open, so a double click reaches Basalt. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Visual Basic source</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>vb</string>
        <string>bas</string>
        <string>vbhtml</string>
      </array>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Solution</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>sln</string>
        <string>slnx</string>
        <string>vbproj</string>
      </array>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
    </dict>
  </array>
</dict>
</plist>
