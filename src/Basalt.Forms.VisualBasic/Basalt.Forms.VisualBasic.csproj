<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Packable once the spine holds: the package will carry this assembly alongside System.Windows.Forms. -->
    <IsPackable>false</IsPackable>

    <!--
      Microsoft's name, for the reason Basalt.Drawing carries
      System.Drawing.Common's and Basalt.Forms carries System.Windows.Forms's: a
      compiled VB application looks up MsgBox, InputBox and My by reflecting into
      the assembly named Microsoft.VisualBasic.Forms and binds by simple name,
      ignoring the public key. A net10.0 binary asks for 10.0.0.0 and the
      runtime refuses a lower version.
    -->
    <AssemblyName>Microsoft.VisualBasic.Forms</AssemblyName>
    <RootNamespace>Microsoft.VisualBasic</RootNamespace>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Basalt.Forms\Basalt.Forms.csproj" />
    <ProjectReference Include="..\Basalt.Windows.Extensions\Basalt.Windows.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Basalt.Forms.Tests" />
  </ItemGroup>

</Project>
