<Project>

  <!--
    The views are content: they are compiled by the generator, so publishing
    them alongside would ship the templates as well as the code made from them.

    Written with an Include pattern rather than a condition on %(Extension):
    referring to item metadata in a top-level condition is not allowed, and
    doing so fails the build of every project that references this package.
  -->
  <ItemGroup>
    <Content Remove="**/*.vbhtml" />
    <Content Remove="**/*.vbrazor" />
  </ItemGroup>

  <!--
    CSS isolation for components: Counter.vbrazor.css is scoped to
    Counter.vbrazor, as Counter.razor.css is to Counter.razor.

    The SDK's pipeline discovers only .razor.css and .cshtml.css, and its
    ApplyCssScopes step rejects a scoped stylesheet with no C# component
    beside it. So the .vbrazor.css files are given their scopes here, after
    that check, by the SDK's own ComputeCssScope task, and added to _ScopedCss:
    from there the SDK rewrites them and bundles them into
    $(PackageId).styles.css like any other. The scope reaches the component
    generator as the CssScope metadata of the .vbrazor, which it writes on
    every element of the component, as the Razor compiler does. It has to be
    set before the analyzer configuration file is written, or the generator
    reads it empty.
  -->
  <ItemGroup>
    <!-- Processed into the bundle, not published as they stand. -->
    <Content Update="**/*.vbrazor.css" CopyToPublishDirectory="Never" Pack="false" />
  </ItemGroup>

  <Target Name="_BasaltComputeVbRazorCssScopes"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile;ResolveScopedCssOutputs"
          DependsOnTargets="ResolveCssScopes"
          Condition="'$(ScopedCssEnabled)' == 'true'">
    <ItemGroup>
      <_BasaltVbRazorCssInput Include="@(Content);@(None)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('.vbrazor.css', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>

    <ComputeCssScope ScopedCssInput="@(_BasaltVbRazorCssInput)" Targetname="$(TargetName)" Condition="'@(_BasaltVbRazorCssInput)' != ''">
      <Output TaskParameter="ScopedCss" ItemName="_BasaltVbRazorScopedCss" />
    </ComputeCssScope>

    <ItemGroup>
      <_ScopedCss Include="@(_BasaltVbRazorScopedCss)" />

      <!-- Counter.vbrazor.css scopes Counter.vbrazor: its file name less .css. -->
      <_BasaltVbRazorWithScope Include="@(_BasaltVbRazorScopedCss->'%(RelativeDir)%(Filename)')" CssScope="%(_BasaltVbRazorScopedCss.CssScope)" />
      <AdditionalFiles Remove="@(_BasaltVbRazorWithScope)" />
      <AdditionalFiles Include="@(_BasaltVbRazorWithScope)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="CssScope" />
  </ItemGroup>

  <!--
    Collocated JavaScript: Counter.vbrazor.js beside Counter.vbrazor is served
    at ./Components/Counter.vbrazor.js, to be imported as a module with
    IJSRuntime, as Counter.razor.js is. The SDK looks only for .razor.js and
    .cshtml.js, so the same steps it takes for those are taken here for
    .vbrazor.js: define the static web assets and their endpoints, mark them
    as modules, and take them out of Content and None.
  -->
  <Target Name="_BasaltResolveVbRazorJSModules"
          AfterTargets="ResolveJSModuleStaticWebAssets">
    <ItemGroup>
      <_BasaltVbRazorJSCandidate Include="@(Content->Distinct())" Condition="$([System.String]::Copy('%(Identity)').EndsWith('.vbrazor.js', System.StringComparison.OrdinalIgnoreCase))" />
      <_BasaltVbRazorJSCandidate Include="@(None->Distinct())" Exclude="@(Content)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('.vbrazor.js', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>

    <DefineStaticWebAssets Condition="'@(_BasaltVbRazorJSCandidate)' != ''"
      CandidateAssets="@(_BasaltVbRazorJSCandidate)"
      SourceId="$(PackageId)"
      RelativePathPattern="**/*.vbrazor.js"
      ContentRoot="$(MSBuildProjectDirectory)"
      SourceType="Discovered"
      BasePath="$(StaticWebAssetBasePath)"
      AssetMergeSource="$(StaticWebAssetMergeTarget)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)">
      <Output TaskParameter="Assets" ItemName="_BasaltVbRazorJSModule" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints Condition="'@(_BasaltVbRazorJSModule)' != ''"
      CandidateAssets="@(_BasaltVbRazorJSModule)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_BasaltVbRazorJSModuleEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup Condition="'@(_BasaltVbRazorJSModuleEndpoint)' != ''">
      <_BasaltVbRazorJSModuleProperty Include="Append">
        <UpdateTarget>Property</UpdateTarget>
        <Name>script-type</Name>
        <Value>module</Value>
      </_BasaltVbRazorJSModuleProperty>
    </ItemGroup>

    <UpdateStaticWebAssetEndpoints Condition="'@(_BasaltVbRazorJSModuleProperty)' != ''"
      EndpointsToUpdate="@(_BasaltVbRazorJSModuleEndpoint)"
      AllEndpoints="@(_BasaltVbRazorJSModuleEndpoint)"
      Operations="@(_BasaltVbRazorJSModuleProperty)">
      <Output TaskParameter="UpdatedEndpoints" ItemName="_BasaltVbRazorJSModuleEndpointWithProperty" />
    </UpdateStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Remove="@(_BasaltVbRazorJSModule)" />
      <StaticWebAsset Include="@(_BasaltVbRazorJSModule)" />
      <StaticWebAssetEndpoint Include="@(_BasaltVbRazorJSModuleEndpointWithProperty)" />
      <Content Remove="@(_BasaltVbRazorJSModule->'%(OriginalItemSpec)')" />
      <None Remove="@(_BasaltVbRazorJSModule->'%(OriginalItemSpec)')" />
    </ItemGroup>
  </Target>

  <!--
    A project that references this package but has no views has almost
    certainly misplaced them, and would otherwise get a silent empty build.
  -->
  <Target Name="WarnWhenNoVbHtmlViewsFound" BeforeTargets="CoreCompile"
          Condition="'$(BasaltRazorVbWarnOnEmpty)' != 'false'">
    <ItemGroup>
      <_VbHtmlViews Include="@(AdditionalFiles)" />
      <!-- Views, pages and components alike: a Blazor app has only .vbrazor
           files, and was told it had no views. -->
      <_VbHtmlViews Remove="@(_VbHtmlViews)"
                    Condition="'%(Extension)' != '.vbhtml' and '%(Extension)' != '.vbrazor' and '%(Extension)' != '.vbpage'" />
    </ItemGroup>

    <Warning Code="VBRZ001"
             Text="Basalt.Razor.Vb is referenced but no .vbhtml, .vbrazor or .vbpage templates were found. Set BasaltRazorVbWarnOnEmpty to false to silence this."
             Condition="'@(_VbHtmlViews)' == ''" />
  </Target>

</Project>
