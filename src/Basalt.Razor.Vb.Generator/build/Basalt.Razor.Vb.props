<Project>

  <PropertyGroup>
    <!--
      Set before the collection below reads it: MSBuild evaluates a props file
      top to bottom, so a guard declared underneath the group it guards is
      always empty when the group is evaluated.

      Guards against collecting every view twice when
      Basalt.Razor.Vb.AspNetCore is referenced alongside this package: both
      carry the same collection, and a view added twice is generated twice and
      fails the build on duplicate class definitions.
    -->
    <BasaltRazorVbViewsCollected Condition="'$(BasaltRazorVbViewsCollected)' == ''">basalt.razor.vb</BasaltRazorVbViewsCollected>

    <!--
      The generator needs the project directory to turn a view's full path
      into the application-relative one ASP.NET Core routes on: /Pages/Index
      rather than /Users/someone/src/MySite/Pages/Index.
    -->
    <BasaltProjectDir Condition="'$(BasaltProjectDir)' == ''">$(MSBuildProjectDirectory)</BasaltProjectDir>
  </PropertyGroup>

  <!--
    Every .vbhtml file in the project is handed to the generator, without the
    user having to list them. Imported before the project file so that a
    project can still remove or add to the set.
  -->
  <ItemGroup Condition="'$(BasaltRazorVbViewsCollected)' == 'basalt.razor.vb'">
    <!-- .vbpage, spelled out: the glob was "*.vbp", which names Visual Basic 6
         project files, not pages. -->
    <AdditionalFiles Include="**/*.vbpage"
                     Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin/**;obj/**" />
    <AdditionalFiles Include="**/*.vbhtml"
                     Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin/**;obj/**" />

    <!-- Blazor components: a .vbrazor is compiled into a render tree rather
         than into a class that writes markup, which is why it carries its own
         extension the way .razor does beside .cshtml. -->
    <AdditionalFiles Include="**/*.vbrazor"
                     Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);bin/**;obj/**" />
    <CompilerVisibleProperty Include="BasaltProjectDir" />
    <!-- On or Off for the templates alone; unset, they follow OptionStrict. -->
    <CompilerVisibleProperty Include="VbRazorOptionStrict" />
    <!-- Legacy for the namespaces components had before they followed their folders. -->
    <CompilerVisibleProperty Include="VbRazorComponentNamespaces" />
  </ItemGroup>

</Project>
