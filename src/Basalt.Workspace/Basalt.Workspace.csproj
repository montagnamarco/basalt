<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Basalt.Core\Basalt.Core.csproj" />
    <ProjectReference Include="..\Basalt.Extensibility\Basalt.Extensibility.csproj" />
    <ProjectReference Include="..\Basalt.Razor.Vb\Basalt.Razor.Vb.csproj" />
    <ProjectReference Include="..\Basalt.QuickBasic\Basalt.QuickBasic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>

  <!--
    MSBuildLocator loads the MSBuild assemblies from the .NET SDK installed on
    the machine. The copies that come from NuGet must not end up in the
    output, or two conflicting versions of MSBuild would be loaded at runtime.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Linked rather than duplicated: this is the generator's own catalog
    builder, which declares every .vbrazor's parameters from the compilation
    before any render tree is written. The editor asks the same question
    about the same compilation, and a second copy of this logic would be a
    second chance for the two to disagree about what a tag means.
  -->
  <ItemGroup>
    <Compile Include="..\Basalt.Razor.Vb.Generator\ComponentCatalogBuilder.cs" Link="Web\ComponentCatalogBuilder.cs" />
    <!-- Tag helpers found the way the build finds them, for a view's asp-* completion. -->
    <Compile Include="..\Basalt.Razor.Vb.Generator\TagHelperDiscovery.cs" Link="Web\TagHelperDiscovery.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by LibraryImport, used for the pseudo-terminal interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The tests check parsing details that are not part of the public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Basalt.Tests" />
  </ItemGroup>

</Project>
