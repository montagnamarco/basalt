<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!--
      Microsoft splits a few types (Padding, Message, HighDpiMode) out of
      System.Windows.Forms into this assembly, and a compiled Designer.vb
      names them here: the name must match for such a binary to bind. It
      ships inside the Basalt.Forms package, not as a package of its own.
    -->
    <AssemblyName>System.Windows.Forms.Primitives</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="System.Windows.Forms" />
    <InternalsVisibleTo Include="Basalt.Forms.Tests" />
  </ItemGroup>

</Project>
