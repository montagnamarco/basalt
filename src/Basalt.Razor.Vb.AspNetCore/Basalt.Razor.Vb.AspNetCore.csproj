<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!--
      net10.0 rather than netstandard2.0: unlike Basalt.Razor.Vb, this is not
      compiled into the source generator. It is referenced by the user's web
      application and runs beside ASP.NET Core.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <PackageId>Basalt.Razor.Vb.AspNetCore</PackageId>
    <Description>Serves .vbhtml views from ASP.NET Core MVC and Razor Pages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="build/Basalt.Razor.Vb.AspNetCore.props"
          Pack="true" PackagePath="build" Visible="false" />

    <!--
      The same physical file Basalt.Razor.Vb.Generator packs as
      Basalt.Razor.Vb's own build/Basalt.Razor.Vb.Templates.props: one
      definition of what templates are collected and how BasaltRelativePath
      is computed, imported by both packages' .props (see
      Basalt.Razor.Vb.Templates.props). NuGet imports a package's build/
      folder only for a PackageReference the project makes directly, so this
      package needs its own copy of the file to import, not just of the
      .props that imports it.
    -->
    <None Include="../Basalt.Razor.Vb.Generator/build/Basalt.Razor.Vb.Templates.props"
          Pack="true" PackagePath="build" Visible="false"
          Link="build/Basalt.Razor.Vb.Templates.props" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- For ViewNaming: the path-to-class rules must not be duplicated here,
         or a view would be generated under one name and looked up by another. -->
    <!--
      Build and Analyzers assets flow through deliberately. NuGet excludes them
      from a ProjectReference by default, which would leave anyone installing
      this package with the runtime but no generator and no targets: their
      project would build clean and produce no views at all, with nothing said
      about why. The generator is the whole point of the dependency.
    -->
    <ProjectReference Include="..\Basalt.Razor.Vb\Basalt.Razor.Vb.csproj"
                      PrivateAssets="none" />
  </ItemGroup>

</Project>
